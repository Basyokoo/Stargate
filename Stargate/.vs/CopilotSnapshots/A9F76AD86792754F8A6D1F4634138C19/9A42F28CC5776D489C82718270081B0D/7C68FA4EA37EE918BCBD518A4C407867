        private void NavigerVers(string destination)
        {
            switch (destination)
            {
                case "volet2": newMission_Click(null, EventArgs.Empty); break;
                case "volet5": races_Click(null, EventArgs.Empty);      break;
                case "volet6": planetes_Click(null, EventArgs.Empty);   break;
