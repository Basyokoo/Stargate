        /// <summary>
        /// Après le retour d'un volet, vérifie si une navigation vers un autre volet a été demandée.
        /// Sinon, réaffiche le tableau de bord.
        /// </summary>
        private void GererNavigationRetour()
        {
            string destination = NavHelper.ProchainVolet;
            NavHelper.ProchainVolet = null;

            if (destination != null)
            {
                NavigerVers(destination);
            }
            else
            {
                this.Show();
                MissionLoad(filtreActif); // Rafraîchir au retour
            }
        }

