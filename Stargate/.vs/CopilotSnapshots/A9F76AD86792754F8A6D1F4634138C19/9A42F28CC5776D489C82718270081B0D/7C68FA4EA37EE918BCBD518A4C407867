        // ══════════════════════════════════════════════════════════════════════════
        // TABLEAU DE BORD — chargement et filtrage des missions
        // ══════════════════════════════════════════════════════════════════════════

        /// <summary>
        /// Charge et affiche les cartes de missions selon le filtre sélectionné.
        /// Affiche une fenêtre de chargement pendant l'opération.
        /// </summary>
        private void MissionLoad(string filtre = "Toutes")
        {
            filtreActif = filtre;

            FormChargement chargement = new FormChargement("⏳  Chargement des missions...");
            chargement.Show(this);
            Application.DoEvents(); // Forcer le rendu de la fenêtre de chargement

            try
            {
                conn.Open();

                // Construction de la clause WHERE selon le filtre
                string today = DateTime.Today.ToString("yyyy-MM-dd");
                string whereSQL = "";
                if (filtre == "En cours")
                    whereSQL = $" WHERE dateDepart <= '{today}' AND dateRetour >= '{today}'";
                else if (filtre == "À venir")
                    whereSQL = $" WHERE dateDepart > '{today}'";
                else if (filtre == "Terminé")
                    whereSQL = $" WHERE dateRetour < '{today}'";

                string query = "SELECT * FROM Mission" + whereSQL;
                SQLiteCommand cmd = new SQLiteCommand(query, conn);
                SQLiteDataReader reader = cmd.ExecuteReader();

                flpVolet1.Controls.Clear();
                int tag = 0;

                while (reader.Read())
                {
                    string nomPlanete  = reader["nomPlanete"].ToString();
                    string numero      = reader["numero"].ToString();
                    string missionName = nomPlanete + " - " + numero;
                    string dateDeb     = reader["dateDepart"].ToString();
                    string dateFin     = reader["dateRetour"].ToString();
                    string nomChef     = reader["matriculeChef"].ToString();
                    string budget      = reader["budget"].ToString() + " dollars galactiques";

                    // Résolution du matricule en nom complet
                    using (var cmd2 = new SQLiteCommand(
                        $"SELECT nom FROM Membre WHERE matricule = '{nomChef}'", conn))
                        nomChef = cmd2.ExecuteScalar()?.ToString() ?? "Inconnu";

                    MissionViewer carte = new MissionViewer("images.png", missionName, dateDeb, dateFin, nomChef, budget);
                    carte.afficheur = OuvrirMission;
                    carte.Tag = tag;
                    flpVolet1.Controls.Add(carte);
                    tag++;
                }

                reader.Close();
                cmd.Dispose();
            }
            catch (Exception ex)
            {
                MessageBox.Show("Erreur lors du chargement des missions : " + ex.Message,
                    "Erreur", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
            finally
            {
                conn.Close();
                chargement.Close();
                chargement.Dispose();
            }
        }

        /// <summary>
        /// Ouvre le récapitulatif d'une mission (Form3) suite au clic sur une carte.
        /// </summary>
        private void OuvrirMission(object sender, EventArgs e)
        {
            if (!(sender is Button btn)) return;
            if (!(btn.Parent is MissionViewer carte)) return;

            string[] parts = carte.get_NomMission().Split('-');
            if (parts.Length < 2) return;

            string planete = parts[0].Trim();
            if (!int.TryParse(parts[1].Trim(), out int numero)) return;

            this.Hide();
            Form3 v3 = new Form3(planete, numero);
            v3.ShowDialog();

            GererNavigationRetour();
        }

