        /// <summary>
        /// Met en évidence le bouton de filtre sélectionné et réinitialise les autres.
        /// </summary>
        private void AppliquerStyleFiltreActif(Button btnActif)
        {
            // Réinitialiser tous les boutons
            foreach (Button btn in new[] { btnFiltreToutes, btnFiltreEnCours, btnFiltreAVenir, btnFiltreTermine })
            {
                btn.FlatAppearance.BorderSize = 0;
            }

            // Mettre en évidence le bouton actif avec une bordure
            btnActif.FlatAppearance.BorderSize = 2;
            btnActif.FlatAppearance.BorderColor = Color.FromArgb(230, 235, 255);
            boutonFiltreActif = btnActif;
        }
